{
  "sdk": {
    "version": "12.0.100-alpha.1.26555.106",
    "allowPrerelease": true,
    "rollForward": "latestMajor",
    "paths": [
      ".dotnet",
      "$host$"
    ],
    "errorMessage": "The required .NET SDK wasn't found. Please run ./restore.sh or .\\restore.cmd to install it."
  },
  "tools": {
    "dotnet": "12.0.100-alpha.1.26555.106",
    "runtimes": {
      "dotnet": [
        "$(DotNetRuntime100Version)",
        "$(DotNetRuntime110Version)"
      ],
      "dotnet/x86": [
        "$(DotNetRuntime100Version)",
        "$(DotNetRuntime110Version)"
      ]
    }
  },
  "msbuild-sdks": {
    "Microsoft.DotNet.Arcade.Sdk": "12.0.0-beta.26569.6",
    "Microsoft.DotNet.Helix.Sdk": "12.0.0-beta.26569.6",
    "Microsoft.Build.NoTargets": "3.7.134",
    "Microsoft.Build.Traversal": "4.1.82"
  }
}
